script = ExtResource("2_6sxmd")
lines = Array[String](["Carmen: Aquí tienes la receta, con ella podrás guiarte paso a paso en cómo
debes preparar la comida.", "Carmen: Puedes acceder a ella pulsando la letra \"R\".", "Carmen: Empecemos por la carne. Cada carne tiene distintos usos, recuerda eso.", "Carmen: Ve a la refrigeradora y saca el trozo de carne cruda. Para abrirla pulsa la letra \"E\"."])
