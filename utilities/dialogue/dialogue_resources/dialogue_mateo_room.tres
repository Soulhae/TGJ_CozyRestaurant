[resource]
script = ExtResource("2_8qtjo")
lines = Array[String](["Mary: Hijo, ¿Puedo pasar?.", "Mateo: Si, puedes entrar.", "Mary: Estoy preocupada por cómo te has estado sintiendo, cada vez sonríes menos, has bajado de peso y ya no sonríes como hacías antes...", "Mateo: Estoy bien mamá, no te preocupes, solo estoy un poco desanimado, pronto estaré mejor.", "Mary: Mateo, se que siempre intentas hacerte el fuerte, pero me preocupa que esto siga escalando.", "Mateo: En serio, no es nada, solo necesito descansar un poco.", "Mary: Cariño, muchas veces he visto como intentas cargar con todo, ¿Pero sabes? hay veces en que simplemente las cosas nos superan...", "Mary: Y cuando eso pasa, es importante que no te lo guardes, estoy aquí y quiero que sepas que de verdad puedes contar conmigo.", "Mateo: Parece que no se me da bien ocultar las cosas, yo... Lamento ser tan débil...", "Mary: Mateo, yo jamás te he visto como alguien débil, solo creo que estás llevando más peso del que puedes cargar.", "Mary: Yo era igual que tú, pero fue gracias a mi madre que pude ser más paciente conmigo misma y ver mucho más allá de lo que antes nunca pude.", "Mary: Creo que te haría muy bien cambiar un poco los aires, voy a llevarte unos días para que te quedes con mi madre, es una persona muy sabia, estoy seguro que te hará muy bien.", "Mateo: Si tu lo dices, creeré en tus palabras mamá.", "Mary: Gracias por creer en mí, significa mucho, en serio. Ahora debes dormir, el viaje es largo, saldremos mañana a primera hora. Buenas noches hijo...", "Mateo: Buenas noches mamá."])
portraits = Array[Texture2D]([ExtResource("2_dywfh"), ExtResource("3_xn2xf"), ExtResource("4_rgrgj"), ExtResource("5_q4ph0"), ExtResource("4_rgrgj"), ExtResource("5_q4ph0"), ExtResource("4_rgrgj"), ExtResource("6_q4ph0"), ExtResource("7_iq4cq"), ExtResource("2_dywfh"), ExtResource("2_dywfh"), ExtResource("6_q4ph0"), ExtResource("3_xn2xf"), ExtResource("6_q4ph0"), ExtResource("8_u22oe")])
