lines = Array[String](["Carmen: Mateo, despierta!", "Carmen: Buenos días dormilón.", "Carmen: Duermes igual de profundo como lo hacía tu madre.", "Mateo: Abuela?", "Mateo: 5 minutos más por favor...", "Carmen: Al que madruga Dios lo ayuda hijito, vamos, aun queda limpiar lo del día de ayer.", "Carmen: El tiempo pasa más rápido de lo que crees.", "Mateo: Ya voy...", "Carmen: Yo estaré limpiando también!"])
