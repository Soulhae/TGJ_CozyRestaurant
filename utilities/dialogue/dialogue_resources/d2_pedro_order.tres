[resource]
script = ExtResource("2_htt2x")
lines = Array[String](["Mateo: Bienvenido a Yuyay, ¿Cómo puedo ayudarle el día de hoy?", "Pedro: Épale Mateo, que tal, soy Pedro.", "Mateo: ¿É-Épale?", "Pedro: Oh, disculpa si te sorprendí, así saludaba en mi país, es algo que me gusta mantener. Soy de Venezuela.", "Mateo: Es primera vez que alguien me saluda así, fue inesperado!.", "Mateo: Un gusto joven Pedro.", "Mateo: Dígame, ¿Cómo puedo ayudarle?", "Pedro: Verás Mateo, hoy es mi día libre, trabajo 6 días a la semana y me sentía muy cansado para cocinar algo.", "Pedro: Y aunque lo haga, no me siento muy cómodo cuando termino de preparar la comida y me voy a sentar a la mesa.", "Pedro: No hay nadie ahí que me espere.", "Pedro: Extraño mucho la compañía de mi mamá y mis amigos, ellos están muy lejos.", "Pedro: Me preguntaba si podrían darme algo aquí que me suba un poco la moral.
", "Mateo: Deme un segundo, veré que puedo hacer."])
portraits = Array[Texture2D]([ExtResource("2_2xmip"), ExtResource("3_ty0tj"), ExtResource("4_kxr32"), ExtResource("5_a3bx0"), ExtResource("6_7nelw"), ExtResource("7_fadlq"), ExtResource("8_7jkoo"), ExtResource("9_gk866"), ExtResource("10_xn6wt"), ExtResource("10_xn6wt"), ExtResource("10_xn6wt"), ExtResource("9_gk866"), ExtResource("11_yk2ss")])
