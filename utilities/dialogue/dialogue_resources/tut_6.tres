lines = Array[String](["Carmen: Para esta comida la cebolla te ha quedado muy pequeña.", "Carmen: No te preocupes, toma el alimento y deséchalo.", "Carmen: Para esto, toma la cebolla con \"E\" y luego presiona \"X\".", "Carmen: A continuación, corta una nueva cebolla."])
