[ext_resource type="Script" uid="uid://cytnflbegjbj4" path="res://utilities/dialogue/dialogue_data/dialogue_data.gd" id="2_tlofe"]

[resource]
script = ExtResource("2_tlofe")
lines = Array[String](["Mateo: Bienvenido a Yuyay, ¿Cómo puedo ayudarle el día de hoy?", "Diego: ...", "Mateo: ¿Señor?", "Diego: Disculpa, estaba perdido en mis pensamientos.", "Mateo: ¿Hay algo en que lo pueda ayudar?", "Diego: Hace ya 1 año.", "Mateo: ...", "Diego: Hace ya 1 año desde que mis padres no están conmigo...", "Diego: Como quizá notes por mi acento, vengo desde Chile.", "Diego: Llevo viviendo en Perú hace ya un par de años.", "Diego: Todo estaba bien hasta que…", "Diego: La pandemia nos jodió todo.", "Mateo: ...", "Diego: Pasó sin que nadie lo supiera, fue muy repentino.", "Diego: Controlaron quién entraba y quién salía del país muy difícil alguien podría...", "Diego: Mis papás eran mayores y ellos no, ellos no…", "Diego: ...", "Diego: Lo lamento, me brotaron los sentimientos...", "Diego: Vine a este lugar porque me dijeron que la comida de aquí consuela el alma.", "Mateo: Lamento oír su situación señor.", "Mateo: No me imagino el dolor que conlleva perder a alguien.", "Mateo: Le prepararé algo que le haga sentir mejor, se lo prometo.", "Diego: Muchas gracias..."])
metadata/_custom_type_script = "uid://cytnflbegjbj4"
