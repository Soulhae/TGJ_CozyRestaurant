[resource]
script = ExtResource("2_vvj7h")
lines = Array[String](["Mateo: Abuela, el joven Pedro me pidió un platillo para subirle la moral.", "Mateo: Pero no se que podría prepararle.", "Mateo: Dice que viene de Venezuela, ¿Tienes algo en mente?", "Carmen: Claro que tengo algo!", "Carmen: Con tu tío solíamos ir a muchos lugares antes de abrir el restaurante.", "Carmen: Ten, esto le alegrará el día.", "Carmen: Es un platillo que comen mucho por allá.", "Carmen: En especial en reuniones familiares.", "Carmen: Revisa la receta y pónte a ello!", "Mateo: Haré mi mejor intento por hacer bien las cosas.", "Carmen: Tú puedes!"])
portraits = Array[Texture2D]([ExtResource("2_j8er6"), ExtResource("3_t6u5e"), ExtResource("4_svqvw"), ExtResource("5_dwk0j"), ExtResource("6_838lk"), ExtResource("6_838lk"), ExtResource("5_dwk0j"), ExtResource("6_838lk"), ExtResource("5_dwk0j"), ExtResource("7_8t5kj"), ExtResource("5_dwk0j")])
