[resource]
script = ExtResource("2_eois8")
lines = Array[String](["Carmen: Mateo, buenos días.", "Carmen: Te noto más feliz hoy.", "Mateo: Hola abuela, buenos días!", "Mateo: Creo que tuve un buen sueño, aunque no recuerdo muy bien sobre qué.", "Mateo: Y siendo honesto, se siente bien ver que la gente se va feliz.", "Carmen: ¡¿Verdad?!", "Carmen: Eso es lo que buscamos generar en las personas y lo estás haciendo muy bien.", "Carmen: Voy a limpiar hijito, luego me ayudas con la cocina por favor.", "Mateo: Claro que si, yo me encargo.", "Mateo: ...", "Mateo: Abuela?", "Carmen: ¿Si, Mateo?", "Mateo: Te quiero mucho, gracias por todo lo que haces por mí.", "Carmen: Gracias a ti, por seguir intentándolo hijito.", "Carmen: Eres más que capaz de hacer todo lo que te propongas.", "Carmen: Nunca dudes de ti, eres increible!", "Mateo: ...", "Carmen: Antes que se haga más tarde iré a limpiar.", "Carmen: Cuento contigo Mateito!", "Mateo: ¡Claro!"])
portraits = Array[Texture2D]([ExtResource("2_h7ob4"), ExtResource("2_h7ob4"), ExtResource("3_vveey"), ExtResource("4_64alh"), ExtResource("5_2rp3e"), ExtResource("2_h7ob4"), ExtResource("6_l5ry3"), ExtResource("6_l5ry3"), ExtResource("7_2qte3"), ExtResource("8_dkabh"), ExtResource("8_dkabh"), ExtResource("6_l5ry3"), ExtResource("8_dkabh"), ExtResource("2_h7ob4"), ExtResource("2_h7ob4"), ExtResource("2_h7ob4"), ExtResource("8_dkabh"), ExtResource("6_l5ry3"), ExtResource("2_h7ob4"), ExtResource("7_2qte3")])
metadata/_custom_type_script = "uid://cytnflbegjbj4"
