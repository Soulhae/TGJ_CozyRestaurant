[resource]
script = ExtResource("2_hduwk")
lines = Array[String](["Mateo: Aquí tiene! Espero le guste.", "Camila: Puedo notar el esfuerzo que has puesto en la comida.", "Camila: Es una sensación muy familiar a cuando lo preparaban mis hijas...", "Camila: Creo que son las papas, ellas siempre se enorgullecían de eso. Aunque se les quemaba un poco la carne, pero aún así sabía muy bien.", "Camila: Gracias por haberlo cocinado, me siento muy feliz."])
