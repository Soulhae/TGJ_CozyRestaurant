[resource]
script = ExtResource("2_hx68t")
lines = Array[String](["Mateo: No había visto a un cliente tan triste como el del día de hoy.", "Mateo: De corazón espero que pueda hallar consuelo en la familia que le quede.", "Mateo: Desde que llegué a este lugar todo ha sido un mar de emociones.", "Mateo: Las cosas a veces suelen ser más complicadas de lo que creo.", "Mateo: Pero he aprendido a que puedo con todo ello.", "Mateo: ...", "Mateo: Creo que me quedaré aquí un tiempo más."])
