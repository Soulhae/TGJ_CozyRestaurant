script = ExtResource("2_spd05")
lines = Array[String](["Carmen: Hiciste un excelente trabajo!", "Carmen: Ahora ve a descansar, mañana será un nuevo día.", "Mateo: Gracias abuela, si no fuera por ti, no habría podido haberlo hecho ni la mitad de bien.", "Mateo: Iré a dormir entonces abue, nos vemos mañana.", "Carmen: Hasta mañana hijito."])
